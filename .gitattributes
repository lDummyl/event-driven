# Normalize line endings across platforms
* text=auto

# Java / Maven / sources -> always LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.ndjson text eol=lf

# Windows scripts -> CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Unix scripts -> LF
mvnw text eol=lf

# Binary
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
